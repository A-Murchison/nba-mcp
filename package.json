{
  "name": "nba-mcp",
  "version": "0.1.0",
  "description": "Live-first NBA stats MCP server with provider-agnostic data adapters.",
  "type": "module",
  "bin": {
    "nba-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && bun test test/*.test.mjs",
    "start": "bun dist/index.js",
    "dev": "bun --watch src/index.ts"
  },
  "keywords": [
    "mcp",
    "nba",
    "basketball",
    "live-stats",
    "model-context-protocol"
  ],
  "license": "MIT",
  "packageManager": "bun@1.4.3",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
