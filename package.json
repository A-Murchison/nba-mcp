{
  "name": "nba-mcp",
  "version": "0.1.0",
  "description": "Live-first NBA stats MCP server with provider-agnostic data adapters.",
  "type": "module",
  "bin": {
    "nba-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "nba",
    "basketball",
    "live-stats",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
