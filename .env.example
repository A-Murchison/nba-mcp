# Provider selection. Use mock for deterministic development or nba-com for public live endpoints.
NBA_MCP_PROVIDER=mock

# Live data should refresh aggressively but safely.
NBA_MCP_CACHE_TTL_LIVE_SECONDS=10

# Roster/static-ish data can be cached much longer.
NBA_MCP_CACHE_TTL_ROSTER_SECONDS=86400

# Successful immutable historical aggregates and final results can be cached longer.
NBA_MCP_CACHE_TTL_HISTORICAL_SECONDS=604800

# Historical game-log pages can receive corrections, so use a shorter TTL.
NBA_MCP_CACHE_TTL_HISTORICAL_LOG_SECONDS=86400

# Used when callers omit a timezone.
NBA_MCP_TIMEZONE=America/New_York
